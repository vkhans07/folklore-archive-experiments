# Copy to .env. Shell environment variables take precedence over this file.
# Create keys in Google AI Studio, the Anthropic Console, and the OpenAI API dashboard, then fill them here.
# .env is ignored by Git; never commit real API keys.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required when the Anthropic key can access multiple workspaces.
ANTHROPIC_WORKSPACE_ID=

# Anthropic direct API models
FOLKLORE_SONNET_MODEL=claude-sonnet-5-5
FOLKLORE_HAIKU_MODEL=claude-haiku-5-5
FOLKLORE_OPUS_MODEL=claude-opus-5-5

# OpenAI Responses API
FOLKLORE_ASTRA_MODEL=gpt-6-astra
FOLKLORE_ASTRA_REASONING_EFFORT=medium

# Google Gemini Developer API. Both aliases use Gemini 3.8 Flash;
# the second requests higher thinking effort for comparison.
FOLKLORE_GEMINI_FLASH_MODEL=gemini-3.8-flash
FOLKLORE_GEMINI_FLASH_THINKING_LEVEL=medium
FOLKLORE_GEMINI_FLASH_HIGH_MODEL=gemini-3.8-flash
FOLKLORE_GEMINI_FLASH_HIGH_THINKING_LEVEL=high

FOLKLORE_MAX_TOKENS=16384
FOLKLORE_MAX_ATTEMPTS=3
FOLKLORE_INITIAL_BACKOFF_SECONDS=1
FOLKLORE_TIMEOUT_SECONDS=120
