{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Folklore region predictions v1",
  "type": "object",
  "required": ["annotations"],
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_num", "label", "text", "bbox"],
        "additionalProperties": false,
        "properties": {
          "page_num": {"type": "integer", "minimum": 0},
          "label": {"type": "string"},
          "text": {"type": "string"},
          "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}
        }
      }
    }
  },
  "$comment": "Runtime validation additionally checks configured label enum, document page bound, finite coordinates, and x0<x1/y0<y1."
}
