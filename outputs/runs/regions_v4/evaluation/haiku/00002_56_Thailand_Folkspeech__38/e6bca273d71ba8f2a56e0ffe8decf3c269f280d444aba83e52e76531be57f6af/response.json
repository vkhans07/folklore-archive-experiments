      "text": "{\"annotations\": [{\"page_num\": 0, \"label\": \"folklore_genre\", \"text\": \"Folk Speech — Thai\", \"bbox\": [0.121899, 0.09576, 0.267531, 0.11263]}, {\"page_num\": 0, \"label\": \"informant_age\", \"text\": \"Age 21.\", \"bbox\": [0.590076, 0.09576, 0.645092, 0.11263]}, {\"page_num\": 0, \"label\": \"informant_gender\", \"text\": \"Female\", \"bbox\": [0.651564, 0.09576, 0.703344, 0.11263]}, {\"page_num\": 0, \"label\": \"informant_occupation\", \"text\": \"Student, Library Assistant, Admin. Assistant\", \"bbox\": [0.530631, 0.109784, 0.852232, 0.127252]}, {\"page_num\": 0, \"label\": \"informant_ethnicity\", \"text\": \"‘Thai and 4th generation Chinese in Thailand\", \"bbox\": [0.530744, 0.12543, 0.845738, 0.143425]}, {\"page_num\": 0, \"label\": \"informant_languages\", \"text\": \"English, Central Thai\", \"bbox\": [0.530744, 0.143768, 0.683927, 0.158389]}, {\"page_num\": 0, \"label\": \"informant_address\", \"text\": \"Bellflower, CA.;\", \"bbox\": [0.530744, 0.159401, 0.650485, 0.175146]}, {\"page_num\": 0, \"label\": \"collection_date\", \"text\": \"November 8, 2002\", \"bbox\": [0.659116, 0.159401, 0.791802, 0.175146]}, {\"page_num\": 0, \"label\": \"folklore_item\", \"text\": \"sam/wan/dee/ see / wan / khai/\", \"bbox\": [0.121899, 0.307212, 0.42287, 0.322958]}, {\"page_num\": 0, \"label\": \"folklore_translation\", \"text\": \"three /day /good/ —_four/ day /fever/\", \"bbox\": [0.121899, 0.337765, 0.428264, 0.353511]}, {\"page_num\": 0, \"label\": \"folklore_translation\", \"text\": \"Good for three days and fevered for four days.\", \"bbox\": [0.122977, 0.398872, 0.483281, 0.414618]}, {\"page_num\": 0, \"label\": \"collection_context\", \"text\": \"This is a description I learned from my father, Boonlert Nakkeow.\", \"bbox\": [0.121899, 0.459153, 0.635384, 0.474898]}, {\"page_num\": 0, \"label\": \"informant_explanation\", \"text\": \"He used this to describe my relationship with my 2000-2001 roommate at Stern Hall, the all-female dormitory at UC Berkeley. She was prone to extreme moodswings. One day should she would be laughing and smiling and the next she would be really terse and quiet.\", \"bbox\": [0.121899, 0.459153, 0.860841, 0.5668]}, {\"page_num\": 0, \"label\": \"collector_annotation\", \"text\": \"This bit of folk speech is a personality description used to describe a person with rapidly changing moods who also does not pause to explain why either.\", \"bbox\": [0.121899, 0.54993, 0.867312, 0.627665]}, {\"page_num\": 0, \"label\": \"informant_name\", \"text\": \"Varinthorn Nakkeow,\", \"bbox\": [0.66343, 0.920043, 0.819848, 0.933539]}, {\"page_num\": 0, \"label\": \"informant_age\", \"text\": \"Age 21.\", \"bbox\": [0.825243, 0.920043, 0.88026, 0.933539]}, {\"page_num\": 0, \"label\": \"informant_address\", \"text\": \"10420 Trabuco St.; Bellflower, CA 90706\", \"bbox\": [0.580367, 0.935732, 0.880258, 0.949229]}]}",
